generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id          String   @id @default(uuid())
  type        String
  name        String
  description String   @default("")
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workflow {
  id          String        @id @default(uuid())
  name        String
  description String        @default("")
  type        String        @default("workflow")  // "workflow" | "sub-workflow"
  nodes       String?
  edges       String?
  flowPath    String?
  status      String        @default("draft")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        WorkflowRun[]
}

model WorkflowRun {
  id             String        @id @default(uuid())
  workflowId     String
  status         String        @default("running") // running | success | error | cancelled
  source         String        @default("manual")  // test | webhook | schedule | subWorkflow
  triggerPayload Json?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  error          String?
  nodeOutputs    Json?
  workflow       Workflow      @relation(fields: [workflowId], references: [id])
  logs           WorkflowLog[]
}

model WorkflowLog {
  id          String      @id @default(uuid())
  runId       String
  nodeId      String
  nodeType    String
  stepNr      Int
  status      String      // success | error | skipped | retry
  input       Json?
  output      Json?
  contextDiff Json?
  controlFlow Json?
  error       String?
  meta        Json?
  startedAt   DateTime
  finishedAt  DateTime
  elapsedMs   Int
  run         WorkflowRun @relation(fields: [runId], references: [id])
}

model AIPersona {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String
  tone         String   @default("")
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIPrompt {
  id          String   @id @default(uuid())
  name        String
  template    String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIContext {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIMemory {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
