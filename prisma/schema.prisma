generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id          String   @id @default(uuid())
  type        String
  name        String
  description String   @default("")
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  nodes       String?
  edges       String?
  flowPath    String?
  status      String   @default("draft")
  publish     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIPersona {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String
  tone         String   @default("")
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIPrompt {
  id          String   @id @default(uuid())
  name        String
  template    String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIContext {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIMemory {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
