generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Connection {
  id          String   @id @default(uuid())
  type        String
  name        String
  description String   @default("")
  config      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Workflow {
  id          String        @id @default(uuid())
  name        String
  description String        @default("")
  type        String        @default("workflow")  // "workflow" | "sub-workflow"
  nodes       String?
  edges       String?
  flowPath    String?
  status      String        @default("draft")
  projectId   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  project     Project       @relation(fields: [projectId], references: [id])
  runs        WorkflowRun[]
  versions    WorkflowVersion[]

  @@index([projectId])
}

model Project {
  id          String     @id @default(uuid())
  name        String
  description String     @default("")
  isShared    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workflows   Workflow[]
}

model WorkflowVersion {
  id          String   @id @default(uuid())
  workflowId  String
  version     Int
  name        String
  description String   @default("")
  type        String   @default("workflow")
  nodes       String?
  edges       String?
  status      String   @default("draft")
  source      String   @default("save") // save | restore
  hash        String
  createdAt   DateTime @default(now())
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, version])
  @@index([workflowId, version])
}

model WorkflowRun {
  id             String        @id @default(uuid())
  workflowId     String
  status         String        @default("running") // running | success | error | cancelled
  source         String        @default("manual")  // test | webhook | schedule | subWorkflow
  triggerPayload Json?
  startedAt      DateTime      @default(now())
  finishedAt     DateTime?
  error          String?
  nodeOutputs    Json?
  notifiedAt     DateTime?
  attempt        Int           @default(1)
  retryOfRunId   String?
  nextRetryAt    DateTime?
  workflow       Workflow      @relation(fields: [workflowId], references: [id])
  retryOf        WorkflowRun?  @relation("RunRetries", fields: [retryOfRunId], references: [id], onDelete: SetNull)
  retries        WorkflowRun[] @relation("RunRetries")
  logs           WorkflowLog[]

  @@index([workflowId, notifiedAt])
  @@index([startedAt])
  @@index([workflowId, startedAt])
  @@index([status, nextRetryAt])
  @@index([retryOfRunId])
}

model NotificationSetting {
  id              String   @id @default("default")
  enabled         Boolean  @default(false)
  channel         String   @default("slack") // slack | email | discord
  connectionId    String?
  target          String   @default("")
  throttleMinutes Int      @default(60)
  updatedAt       DateTime @updatedAt
}

model WorkflowLog {
  id          String      @id @default(uuid())
  runId       String
  nodeId      String
  nodeType    String
  stepNr      Int
  status      String      // success | error | skipped | retry
  input       Json?
  output      Json?
  contextDiff Json?
  controlFlow Json?
  error       String?
  meta        Json?
  startedAt   DateTime
  finishedAt  DateTime
  elapsedMs   Int
  run         WorkflowRun @relation(fields: [runId], references: [id])

  @@index([startedAt])
  @@index([status, nodeType])
}

model AIPersona {
  id           String   @id @default(uuid())
  name         String
  systemPrompt String
  tone         String   @default("")
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AIPrompt {
  id          String   @id @default(uuid())
  name        String
  template    String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIContext {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AIMemory {
  id          String   @id @default(uuid())
  name        String
  content     String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TriggerState {
  id           String   @id @default(uuid())
  workflowId   String
  triggerType  String
  key          String
  lastValue    String
  updatedAt    DateTime @updatedAt

  @@unique([workflowId, triggerType, key])
}
