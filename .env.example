# Local development defaults. Copy to .env (make env-init does it for you).
# Never commit .env. Generate real values for anything shared.

DATABASE_URL="postgresql://devdock:devdock@localhost:5432/devdock?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local-only placeholder. Replace before exposing the app:
#   openssl rand -hex 32
DEVDOCK_MASTER_KEY="dev-only-change-me"

# Google OAuth client (Web application) used by workflow nodes.
# Redirect URI: http://localhost:3000/api/oauth/google/callback
# This authorizes API access for nodes; it is not an app sign-in.
# Step-by-step guide: /docs/google-oauth in the running app.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override when the app is served from another host.
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"

# App sign-in (optional). AUTH_MODE=disabled keeps the current single-user mode.
# AUTH_MODE="oidc" enables OIDC login and protects every route except /login,
# /api/auth, /api/oauth and /api/webhooks.
AUTH_MODE="disabled"
AUTH_OIDC_ISSUER="https://iam.example.com"
AUTH_OIDC_CLIENT_ID=""
AUTH_OIDC_CLIENT_SECRET=""
AUTH_REDIRECT_URI="http://localhost:3000/api/auth/callback"
AUTH_OIDC_SCOPES="openid profile email offline_access hc.permissions"
# Session signing key. Generate with: openssl rand -hex 32
AUTH_SECRET=""
AUTH_SESSION_TTL="28800"
# Comma-separated emails/groups that always get the admin role.
AUTH_ADMIN_EMAILS=""
AUTH_ADMIN_GROUPS=""
# Link an existing local user by email when the IdP does not mark it verified.
AUTH_TRUST_EMAIL="false"
# Make the first user to sign in an admin when no admin email is configured.
AUTH_BOOTSTRAP_FIRST_USER="true"
# End the upstream session on logout. Requires an IdP that accepts client_id
# without id_token_hint (Hortus Clavis PR #2 or later).
AUTH_UPSTREAM_LOGOUT="false"

# Option B: DevCadence-branded login form backed by the Hortus API.
# Passwords are sent from the DevCadence server to Hortus and never stored.
# Does not provide SSO or BYO IdP; use AUTH_MODE=oidc for that.
# AUTH_MODE="hortus"
# AUTH_API_URL="http://localhost:8000"
# AUTH_API_SERVICE="devcadence"
