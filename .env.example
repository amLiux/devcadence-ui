# Local development defaults. Copy to .env (make env-init does it for you).
# Never commit .env. Generate real values for anything shared.

DATABASE_URL="postgresql://devdock:devdock@localhost:5432/devdock?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local-only placeholder. Replace before exposing the app:
#   openssl rand -hex 32
DEVDOCK_MASTER_KEY="dev-only-change-me"

# Google OAuth client (Web application) used by workflow nodes.
# Redirect URI: http://localhost:3000/api/oauth/google/callback
# This authorizes API access for nodes; it is not an app sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override when the app is served from another host.
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
